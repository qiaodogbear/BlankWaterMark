{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlindWaterMark",
  "version": "0.1.0",
  "identifier": "com.qiaodogbear.blindwatermark",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BlindWaterMark",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Blind watermark image generator and parser",
    "longDescription": "Local-first blind watermark image generation and parsing tool for Web, desktop, and mobile."
  }
}
